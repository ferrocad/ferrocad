# Rust build output
/target/

# OCCT prefix fetched by the geometry CI job / local geometry work
/.occt/

# Packaged native libraries (build artifacts)
/python/*.so
/python/*.dylib
/python/*.dll
/python/FreeCAD/*.so
/python/FreeCAD/*.dylib
/python/FreeCAD/*.dll

# Python
__pycache__/
*.py[cod]

# Downloaded packaging tools (e.g. appimagetool-<arch>.AppImage)
/tools/*.AppImage

# Upstream workbenches fetched by `cargo xtask mods` (only the README is tracked)
/mods/*
!/mods/README.md

# Publish staging: transient copies of the workspace payload beside the app crate
# so `cargo publish` (with the crate's `include` allowlist) carries them. Removed
# after publishing; never committed. See docs/distribution.md.
/crates/ferrocad/python/
/crates/ferrocad/mods/
