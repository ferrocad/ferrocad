# Rust build output
/target/

# Packaged native libraries (build artifacts)
/python/*.so
/python/*.dylib
/python/*.dll
/python/FreeCAD/*.so
/python/FreeCAD/*.dylib
/python/FreeCAD/*.dll

# Python
__pycache__/
*.py[cod]

# Downloaded packaging tools (e.g. appimagetool-<arch>.AppImage)
/tools/*.AppImage

# Upstream workbenches fetched by `cargo xtask mods` (only the README is tracked)
/mods/*
!/mods/README.md
