+++ sys-mod/include/fc_history.hxx	2026-10-05 23:00:43.495902073 +0100
@@ -0,0 +1,85 @@
+#pragma once
+
+#include <BRepAlgoAPI_Common.hxx>
+#include <BRepAlgoAPI_Cut.hxx>
+#include <BRepAlgoAPI_Fuse.hxx>
+#include <BRepBuilderAPI_MakeShape.hxx>
+#include <BRepTools_History.hxx>
+#include <TopTools_ListOfShape.hxx>
+#include <TopoDS_Shape.hxx>
+
+// FerroCAD spike: history accessors for the boolean operations, without bridging
+// Handle(BRepTools_History). For one input sub-shape `s`:
+//   modified/generated/deleted  from BRepBuilderAPI_MakeShape (the operation base)
+//   history_*                   from BRepTools_History (the richer graph), or -1
+//                               when the operation carries no history object.
+// Reads only; `op` must already be built.
+
+inline void fc_brep_fuse_history(BRepAlgoAPI_Fuse& op,
+                                 const TopoDS_Shape& s,
+                                 int& modified,
+                                 int& generated,
+                                 int& deleted,
+                                 int& history_modified,
+                                 int& history_generated,
+                                 int& history_removed)
+{
+    modified = op.Modified(s).Size();
+    generated = op.Generated(s).Size();
+    deleted = op.IsDeleted(s) ? 1 : 0;
+    Handle(BRepTools_History) h = op.History();
+    if (!h.IsNull()) {
+        history_modified = h->Modified(s).Size();
+        history_generated = h->Generated(s).Size();
+        history_removed = h->IsRemoved(s) ? 1 : 0;
+    }
+    else {
+        history_modified = history_generated = history_removed = -1;
+    }
+}
+
