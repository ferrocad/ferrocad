[package]
readme = "README.md"
homepage = "https://bite-gpui.github.io/"
repository = "https://github.com/bite-gpui/bite-gpui"
description = "gpui_apple \u2014 part of the bite-gpui rearchitecture of zed's gpui"
name = "bite-gp-apple"
version = "1.24.402"
edition.workspace = true
license = "Apache-2.0"

[lints]
workspace = true

[lib]
name = "gpui_apple"
path = "src/gpui_apple.rs"
doctest = false

[features]
default = []
bench-support = ["gpui_platform/bench-support"]
test-support = ["gpui_platform/test-support"]
runtime_shaders = []

[dependencies]
gpui_platform.workspace = true
gpui_engine.workspace = true

[target.'cfg(any(target_os = "macos", target_os = "ios"))'.dependencies]
anyhow.workspace = true
async-task.workspace = true
block2.workspace = true
core-foundation.workspace = true
core-graphics.workspace = true
core-video = { workspace = true, features = ["metal"] }
derive_more.workspace = true
dispatch2.workspace = true
etagere.workspace = true
foreign-types.workspace = true
gpui_util.workspace = true
image.workspace = true
libc.workspace = true
log.workspace = true
mach2.workspace = true
metal.workspace = true
objc2.workspace = true
objc2-foundation = { workspace = true, features = ["NSThread"] }
objc2-quartz-core.workspace = true
parking_lot.workspace = true

[target.'cfg(any(target_os = "macos", target_os = "ios"))'.build-dependencies]
cbindgen.workspace = true

[target.'cfg(any(target_os = "macos", target_os = "ios"))'.dev-dependencies]
gpui = { features = ["test-support"], package = "bite-gpui", path = "../gpui" }

[package.metadata.bite]
source = "https://github.com/bite-gpui/bite-gpui.git"
branch = "bite_v1.24.x"
commit = "8b288f1a2a06ed463d56228823a2f28a911e8855"
upstream = "1.24.4"
amendment = 2
original = "gpui_apple"
