[package]
readme = "README.md"
homepage = "https://bite-gpui.github.io/"
repository = "https://github.com/bite-gpui/bite-gpui"
description = "gpui_wgpu \u2014 part of the bite-gpui rearchitecture of zed's gpui"
name = "bite-gp-wgpu"
version = "1.24.402"
edition.workspace = true
license = "Apache-2.0"

[lints]
workspace = true

[lib]
name = "gpui_wgpu"
path = "src/gpui_wgpu.rs"
doctest = false

[features]
default = []
bench-support = ["gpui/bench-support", "dep:image"]
# Exposes the headless renderer (and the `image` dependency it reads back with) without pulling in
# `gpui/test-support`, so a platform crate can build one from `current_headless_renderer` without a
# feature cycle.
headless = ["dep:image"]
font-kit = ["dep:font-kit"]
test-support = ["gpui/test-support", "dep:image"]

[dependencies]
gpui_platform.workspace = true
gpui_engine.workspace = true
anyhow.workspace = true
bytemuck.workspace = true
collections.workspace = true
cosmic-text = "0.19.0"
etagere.workspace = true
itertools.workspace = true
image = { workspace = true, optional = true }
log.workspace = true
parking_lot.workspace = true
pollster.workspace = true
profiling.workspace = true
raw-window-handle.workspace = true
smallvec.workspace = true
swash.workspace = true
unicode-bidi.workspace = true
unicode-segmentation.workspace = true
gpui_util.workspace = true

# Optional: only needed on platforms with multiple font sources (e.g. Linux)
# WARNING: If you change this, you must also publish a new version of zed-font-kit to crates.io
font-kit = { workspace = true, optional = true }

[target.'cfg(any(target_os = "linux", target_os = "freebsd"))'.dependencies]
wgpu = { workspace = true, features = ["std", "parking_lot", "metal", "gles", "vulkan", "wgsl", "webgpu"] }

[target.'cfg(not(any(target_os = "linux", target_os = "freebsd")))'.dependencies]
wgpu = { workspace = true, default-features = true }

[target.'cfg(target_family = "wasm")'.dependencies]
web-sys = { workspace = true, features = ["HtmlCanvasElement"] }
wgpu = { workspace = true, features = ["webgl"] }

# The dma-buf surface arm imports a raw `VkImage` over an external descriptor, which `wgpu` can adopt
# (`texture_from_raw`) but cannot create. The version must match the one `wgpu-hal` links against.
[target.'cfg(target_os = "linux")'.dependencies]
ash = "0.38"
# `poll(2)`, to wait on a surface's acquire fence. See `src/dmabuf.rs`.
libc.workspace = true

[dev-dependencies]
criterion.workspace = true
gpui = { features = ["bench-support", "platform"], package = "bite-gpui", path = "../gpui" }
image.workspace = true
naga = { version = "29.0.4", features = ["wgsl-in"] }

[[bench]]
name = "layout_line"
harness = false

[package.metadata.bite]
source = "https://github.com/bite-gpui/bite-gpui.git"
branch = "bite_v1.24.x"
commit = "8b288f1a2a06ed463d56228823a2f28a911e8855"
upstream = "1.24.4"
amendment = 2
original = "gpui_wgpu"
