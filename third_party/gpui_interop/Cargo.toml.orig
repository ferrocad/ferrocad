[package]
name = "gpui_interop"
version = "0.2.0"
edition.workspace = true
publish.workspace = true
license = "Apache-2.0"
description = "Zero-copy external GPU surfaces for GPUI windows"
repository.workspace = true
homepage = "https://bite-gpui.github.io/"
documentation = "https://docs.rs/gpui_interop"
readme = "README.md"
keywords = ["gpui", "gpu", "dma-buf", "wgpu", "zero-copy"]
categories = ["gui", "rendering"]

[lints]
workspace = true

[lib]
name = "gpui_interop"
path = "src/gpui_interop.rs"
doctest = false

[package.metadata.docs.rs]
all-features = false
features = ["gpui", "wgpu", "guest"]
rustdoc-args = ["--cfg", "docsrs"]

# The Linux example: the hatch's `SharedBuffer` -- a shareable Vulkan image -- exported as a dma-buf
# and composited by a GPUI window, with no CPU copy. Built only with the `example` feature, which
# brings the facade's platform bundle and the `wgpu` bridge the device it lands on comes from.
[[example]]
name = "interop_linux"
path = "examples/interop_linux.rs"
required-features = ["example"]

# The foreign-viewport example: a producer that owns its device renders a spinning cube into a
# `SharedBuffer` with its own Vulkan pipeline and hands the frame over, no CPU copy. The `example`
# feature again, since it too opens a wgpu window and reaches the renderer's device through `attach`.
[[example]]
name = "interop_cube"
path = "examples/interop_cube.rs"
required-features = ["example"]

# The input example: the same cube, but turned by dragging rather than by a clock, through the input
# gateway. A second example rather than a mode of the first, because the point here is the events.
[[example]]
name = "interop_cube_drag"
path = "examples/interop_cube_drag.rs"
required-features = ["example"]

# The same-device wgpu and Bevy producers are their own crates under `examples/`, so each one's
# dependencies and build profile are independent. `cargo run -p interop_wgpu` or
# `cargo run -p interop_bevy` builds the corresponding producer; switching between them does not
# rebuild this library.

# The read-back test needs the facade's platform bundle and `test-support` (its own feature), and
# builds its buffers on the renderer's device through `Adapter::gpu_device`, so it is opt-in and its
# own feature. Unlike the example it needs no display, but it does drive a window.
[[test]]
name = "linux_dmabuf_readback"
path = "tests/linux_dmabuf_readback.rs"
required-features = ["readback-test"]

# The input gateway's test drives a headless window and simulates pointer input through the normal
# dispatch path, so it needs the facade's `test-support` harness -- but no GPU and no platform
# backend, unlike the read-back test. Its own feature for the same reason: `cargo test` should not
# build the harness for a crate that does not use it.
[[test]]
name = "surface_input"
path = "tests/surface_input.rs"
required-features = ["input-test"]

# The guest runner's test: a worker thread runs a headless GPUI app, hands a frame to the test
# thread as a shareable surface, and the test samples it on the renderer's device. Opt-in like the
# read-back test: it needs the platform bundle and a real Vulkan device.
[[test]]
name = "guest_runner"
path = "tests/guest_runner.rs"
required-features = ["guest-test"]

# The wgpu producer's test: a headless GPUI window composites a texture rendered through the ordinary
# wgpu API on the renderer's own device, and reads the pixel back. The same bundle as the read-back
# test, and opt-in for the same reason.
[[test]]
name = "wgpu_surface"
path = "tests/wgpu_surface.rs"
required-features = ["wgpu-test"]

# The ring's test: a long frame must never be presented with a pending acquire fence.
[[test]]
name = "shared_buffer_ring"
path = "tests/shared_buffer_ring.rs"
required-features = ["wgpu-test"]

# The Windows cross-device test imports the facade directly, so it needs the `gpui` feature;
# without it Cargo would build the test with no `gpui` crate. The file itself is `#![cfg(windows)]`.
[[test]]
name = "cross_device_surface"
path = "tests/cross_device_surface.rs"
required-features = ["gpui"]

[features]
default = []
# The cross-API bridge: the wgpu side of a producer's device, the surface it renders into, and the
# transports it moves.
wgpu = ["dep:wgpu"]
# The facade. The input gateway is the element side of a surface — it subscribes GPUI's pointer
# handlers and adapts them for a producer — so it names GPUI's element traits and events, and nothing
# below the facade. Kept separate from `example` so the gateway is a library API, not an
# example-only one; a producer that wants it (and not the windowing stack) turns on just this.
gpui = ["dep:gpui"]
# The Linux examples open a window with the wgpu renderer, so they turn on the facade's platform
# bundle, on top of the gateway's own facade dependency. A feature and not a dev-dependency's
# `features`, because a dev-dependency's features apply to every test build: without the split,
# `cargo test` would compile the whole platform stack -- and need its system graphics libraries -- for
# a crate whose own code uses none of it.
example = ["gpui", "wgpu", "gpui/platform"]
# The read-back test (`tests/linux_dmabuf_readback.rs`) drives a real offscreen window and builds its
# buffers on the renderer's device through `Adapter::gpu_device`, so it needs the platform bundle,
# `gpui/test-support`'s headless harness, and the `wgpu` bridge. Kept apart from `example` so neither
# turns the other on, and so the ordinary `cargo test` builds neither.
readback-test = ["gpui", "wgpu", "gpui/platform", "gpui/test-support"]
# The wgpu producer's test (`tests/wgpu_surface.rs`) drives a headless window and renders through
# `Adapter::wgpu`'s device, so it needs the same bundle as the read-back test. Kept apart from it so
# neither test's feature turns the other on.
wgpu-test = ["gpui", "wgpu", "gpui/platform", "gpui/test-support"]
# The input gateway's test (`tests/surface_input.rs`) drives a headless window and simulates pointer
# input, so it needs "test-support"'s harness — and the gateway's own facade dependency, but neither
# the platform bundle nor a GPU. Kept on its own so the ordinary `cargo test` builds none of it.
input-test = ["gpui", "gpui/test-support"]
# The guest runner: headless GPUI on a worker thread, handing frames to a foreign host loop. It
# needs the facade's platform bundle (a headless `Application`) and an async channel for the
# command loop. The renderer is the caller's, so this crate names no graphics backend.
guest = ["gpui", "gpui/platform", "dep:futures"]
# The runner's test (`tests/guest_runner.rs`) builds a real headless wgpu renderer and samples its
# frame on the host thread, so it needs the guest feature and the renderer crate, which is already
# a Linux dev-dependency. Kept apart from `guest` so the library does not pull in a backend.
guest-test = ["guest"]

[dependencies]
# The transport and the guest runner report failures as `anyhow` errors; the Linux arm already named it,
# and the guest is not Linux-shaped, so it is a plain dependency rather than a target one.
anyhow.workspace = true
# The facade is named only by the example and the read-back test, whose windows are its; the library
# itself names the engine's payload types. Optional, so a producer that depends on this crate — a
# decoder, a capture pipeline — does not inherit the authoring/runtime/platform stack the facade
# carries.
gpui = { workspace = true, optional = true }
wgpu = { workspace = true, optional = true }
# The guest runner's command channel: the host sends work from its own loop, and the guest task
# awaits it on GPUI's foreground executor. Optional, so the crate's other features stay free of it.
futures = { workspace = true, optional = true }

[build-dependencies]
# The test binary opens a real Direct3D window, whose prompt imports `TaskDialogIndirect`. Only the
# common-controls v6 assembly exports that symbol, and a binary reaches it through its manifest;
# without one the loader binds System32's 5.82 `comctl32.dll` and the process never starts. `gpui`
# carries the manifest for its own targets, which does not reach a downstream test binary.
embed-resource = "3.0"

[target.'cfg(target_os = "linux")'.dependencies]
# The payload types a dma-buf producer names (`DmaBufHandle`, `DmaBufPlane`, `SurfaceFormatKind`) live
# in the engine, so the library depends on it rather than the facade.
gpui_engine.workspace = true

# The Linux transport exports a shareable image as a dma-buf through Vulkan's external-memory
# extensions. `gpui_va`'s VA-API export is its own path and does not use this.
ash = "0.38"
# A `Tiling::Tiled` request the device cannot soundly honour is refused, not silently mistiled.
log = "0.4.16"
# The shared-buffer ring creates the release eventfd and polls acquire fences and
# releases without blocking.
libc = "0.2"

[target.'cfg(target_os = "windows")'.dependencies]
# The Windows transport (`SharedSurface`, `Fence`) is Direct3D 11 + 12. The workspace `windows`
# feature set stops at Direct3D 11; the shared-handle and shared-fence calls are Direct3D 12, so the
# one feature is added here rather than widening every `windows` user in the workspace.
windows = { workspace = true, features = ["Win32_Graphics_Direct3D12"] }

[target.'cfg(target_os = "windows")'.dev-dependencies]
# The cross-device test composites through GPUI's own Direct3D 11 renderer. The renderer type is
# private to `gpui_windows`, so the test does not name it: it reaches the renderer through the
# public `Platform`/`PlatformWindow` seams, and `gpui_windows` is only here to build the platform.
# A dev-dependency and not a dependency: nothing in the library names it, and the facade's own
# graph stays free of the backend crate.
gpui_windows.workspace = true

[target.'cfg(target_os = "linux")'.dev-dependencies]
# The example names `gpui_wgpu::WgpuRenderer` and the read-back test `gpui_wgpu::WgpuHeadlessRenderer`;
# `headless` exposes the headless renderer and the `image` crate it reads back with, without pulling in
# `gpui/test-support`'s platform stack (the read-back test's own feature turns that on). A
# dev-dependency on purpose: the library names neither, so its graph stays free of the renderer crate.
gpui_wgpu = { workspace = true, features = ["headless"] }
# The cube example compiles its WGSL to SPIR-V at run time with `naga` -- the frontend and backend
# `wgpu` itself uses -- so the demo needs no offline shader compiler (`glslc`, `glslangValidator`).
# Dev-dependencies: only the example names a shader, and the shared `naga` picks the features up.
naga = { version = "30.0.1", features = ["wgsl-in", "spv-out"] }
